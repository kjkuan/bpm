#!/usr/bin/env bash
#
# BPM (Bash Process Manager) is a simple process runner / manager inspired by
# [Foreman] and tools alike. It is built based on Bash's job / process management
# capability.
#
# [Foreman]: https://github.com/ddollar/foreman
#
# TODO:
#   - allow user-defined log-tailing command, e.g., using lnav
#
# MAYBE:
#   - Allow reloading Procfile.sh without restarting the server


show-usage () {
    cat <<EOF
Usage: ${0##*/} [options] [command ...]

Options:
    -f  PATH   Path to the Procfile.sh to use. Default is ./Procfile.sh if omitted.

Commands:
    list
        Lists the processes defined in Procfile.sh along with their current statuses.

    start [-t] [NAME_1 NAME_2 ...]
        Starts the named processes (Proc/NAME_1, ...), which are defined in Procfile.sh.
        Starts all defined processes if the names are omitted.
        If -t is specified, each log line will be prefixed with a timestamp.

    stop [-s SIGNAL] [NAME_1 NAME_2 ...]
        Stops (kill) the named processes with SIGNAL (defaults to the TERM signal).
        Stops all started and running processes if the names are omitted.
        A process still running after BPM_STOP_TIMEOUT seconds is killed with KILL.

Environment:
    BPM_STOP_TIMEOUT
        Seconds to wait for a process to stop before killing it (default: 5).
        Read when the server starts.

EOF
}

# For some reason, running in bash interactive mode seems to be needed to have enough
# time to be able to wait for pids after they are killed.
if [[ $- != *i* ]]; then
    exec bash --noediting --noprofile --norc -i "$0" "$@"
fi
shopt -u expand_aliases extglob histappend
set +mH

die () { echo "$@" >&2; exit 1; }

PROCFILE=$PWD/Procfile.sh
declare -A PROC_COLORS
PROC_MAX_WIDTH=

ALLOWED_SIGNALS="INT|TERM|KILL"

OPT_TIMESTAMP=
OPT_SIGNAL=TERM

OPTIND=1
while getopts 'hf:' option; do
    case $option in
        h) show-usage; exit ;;
        f) PROCFILE=$(cd "$(dirname -- "$OPTARG")" && pwd) || die "Invalid Procfile path: $OPTARG"
           PROCFILE=$PROCFILE/$(basename -- "$OPTARG")
           ;;
        *) exit 1 ;;
    esac
done
unset -v option
shift $(( OPTIND - 1 ))

[[ -e $PROCFILE ]] || die "Procfile not found: $PROCFILE"

STOP_TIMEOUT=${BPM_STOP_TIMEOUT:-5}
[[ $STOP_TIMEOUT =~ ^[0-9]+$ ]] ||
    die "BPM_STOP_TIMEOUT must be a whole number of seconds: $STOP_TIMEOUT"

# The directory processes start in: the Procfile's directory, or wherever
# the Procfile cd-ed to (see load-procs).
PROC_DIR=

load-procs () {
    local procs defs
    # NOTE: die below only exits this subshell, so check its status here.
    #       Only the Proc/* functions (and the directory the Procfile ended
    #       up in) are taken from it, so that its other commands and globals
    #       can't interfere with bpm.
    defs=$(
        cd "${PROCFILE%/*}" || exit
        source "$PROCFILE" >/dev/null
        procs=$(declare -F | cut -d' ' -f3 | grep ^Proc/)
        if [[ $procs ]]; then
            set -f; error=
            for name in $procs; do
                ! [[ $name =~ [*?] ]] || { error=x; echo "Invalid process name: $name" >&2; }
            done
            [[ ! $error ]] || die "Failed loading $PROCFILE"
            declare -f $procs
            declare -p procs
            printf 'PROC_DIR=%q\n' "$PWD"
        fi
    ) || exit 1
    eval "$defs"
    procs=$(echo "$procs" | cut -d/ -f2)
    [[ $procs ]] || return 0

    local name color colors=$(
        count=0; [[ ! $procs ]] || count=$(wc -l <<<"$procs")

        # Remove some dark colors for better visibility
        (seq 0 255; printf '%d\n' 0 8 {18..21} {52..57} {88..90} {232..242}) \
          | sort | uniq -u | shuf | head -n $count
        #
        # NOTE: To see all 256 ANSI color codes:
        # for code in {0..255}; do echo -e "\e[38;5;${code}m"'\\e[38;5;'"$code"m"\e[0m"; done
    )
    while read -r name color; do
        PROC_COLORS[$name]=$color
    done < <(paste <(echo "$procs") <(echo "$colors"))

    PROC_MAX_WIDTH=$(echo "$procs |" | column -t | tail -n1 | cut -d\| -f1 | wc -c)
    PROC_MAX_WIDTH=$(( PROC_MAX_WIDTH - 2 ))
}
load-procs
list-all () { declare -F | cut -d' ' -f3 | grep ^Proc/ | cut -d/ -f2; } 2>&1

CMD_FIFO=${PROCFILE%/*}/.bpmfifo
PID_FILE=${PROCFILE%/*}/.bpmpid
send () { printf "%s\n" "$*" > "$CMD_FIFO"; }

server-alive () {
    local pid
    { read -r pid < "$PID_FILE"; } 2>/dev/null
    [[ $pid ]] && kill -0 "$pid" 2>/dev/null
}

# A FIFO left behind by a server that died without cleaning up (e.g., killed
# with SIGKILL) would make every client block forever; remove it.
if [[ -e $CMD_FIFO ]] && ! server-alive; then
    echo "Removing stale $CMD_FIFO (the BPM server is no longer running)." >&2
    rm -f "$CMD_FIFO" "$PID_FILE"
fi

# --- Running as a client ----------------
if [[ -e $CMD_FIFO ]]; then
    send "$*"
    response=$(cat "$CMD_FIFO")
    [[ ! ${response%$'\n'*} ]] || printf "%s\n" "${response%$'\n'*}"
    exit "${response##*$'\n'}"

elif [[ $1 == list ]]; then
    list-all
    exit

elif [[ $1 != start ]]; then
    echo "No process has been started by BPM. Please start one first." >&2
    exit 1
fi

# --- Running as a server ----------------

# Make a process' exit status (from wait) be the process' own status rather
# than its log writer's, which is the last command in the pipeline and
# normally exits 0.
set -o pipefail

declare -A PIDS=()  # process_name -> pid
declare -A PROCS=() # process_name@attr_name -> value

SHUTDOWN=
EXIT_CMDS=()

on-exit () {
    local i
    for ((i=${#EXIT_CMDS[@]}-1; i >= 0; i--)); do
        eval "${EXIT_CMDS[i]}"
    done
}
trap on-exit EXIT

# NOTE: Write the PID file before creating the FIFO so that a client never
#       sees the FIFO without a PID file and mistakes it for a stale one.
echo $$ > "$PID_FILE" || exit
EXIT_CMDS+=('rm -f "$PID_FILE"')
mkfifo -m 0600 "$CMD_FIFO" || exit
EXIT_CMDS+=('rm -f "$CMD_FIFO"')

RESPONSE=()
REPLY_LOCAL=  # set when the command comes from the server itself, not a client
log () { RESPONSE+=("$*"); }
reply () {
    local rc=$? oIFS=$IFS
    IFS=$'\n'
    if [[ $REPLY_LOCAL ]]; then
        (( ! ${#RESPONSE[@]} )) || printf "%s\n" "${RESPONSE[*]}"
    else
        printf "%s\n%d\n" "${RESPONSE[*]}" "${1:-$rc}" > "$CMD_FIFO" 2>&1
    fi
    IFS=$oIFS
    RESPONSE=()
    return $rc
}


# Runs Proc/NAME; meant to be run in the (sub)shell of its pipeline.
#
# NOTE: Since BPM runs as an interactive shell, a subshell of it that's killed
#       by SIGTERM dies without running its EXIT trap. Trap TERM so that the
#       process' EXIT trap still runs, like it would under a non-interactive
#       shell. (Setting this trap in a { ...; } group in the pipeline, rather
#       than in a function, doesn't work.) Also, don't leak pipefail (see
#       above) into the user's process.
run-proc () {
    set +o pipefail
    trap "exit $(( 128 + $(kill -l TERM) ))" TERM
    cd "$PROC_DIR" || exit
    "Proc/$1"
}

start-process () {
    local name=${1:?} pid=${PIDS[$1]:-}

    declare -F "Proc/$name" >/dev/null || {
        log "Unknown process name: $name"
        return 1
    }

    # Process was not started, or has completed;
    [[ ! $pid || ${PROCS[$name@status]:-} ]] || { # otherwise
        log "Process $name ($pid) was already started; please stop it first."
        return 0
    }

    local log_prefix=$(printf "%-${PROC_MAX_WIDTH:-20}s| " "$name")

    set -m
    run-proc "$name" </dev/null 2>&1 \
         |
    # NOTE: The log writer is in the same process group as the process, so it
    #       gets the stop signal too. Ignore it so the writer keeps reading
    #       until the process closes its output, instead of dropping the
    #       process' last lines. (SIGKILL can't be ignored, of course.)
    (trap '' INT TERM
     color_on=$(echo -e "\e[38;5;${PROC_COLORS[$name]}m")
     color_off=$(echo -e "\e[0m")
     # (The || part keeps a last line that has no trailing newline.)
     while IFS= read -r line || [[ $line ]]; do
         [[ ! $OPT_TIMESTAMP ]] || printf -v time '%(%T)T' -1
         line_prefix=${color_on}${time:+$time }${log_prefix}${color_off}
         printf '%s%s\n' "$line_prefix" "$line"
     done
    ) > "$LOG_DIR/$name.log" &
    jobs -x printf -v pid %%
    set +m

    log "Started $name ($pid)"

    PIDS[$name]=$pid
    PROCS[$name@status]=
}

stop-process () {
    local name=${1:?} pid=${PIDS[$1]:-}

    declare -F "Proc/$name" >/dev/null || {
        log "Unknown process name: $name"
        return 1
    }
    [[ $pid ]] || {
        log "Process $name was not started."
        return 0
    }
    if [[ ${PROCS[$name@status]:-} ]]; then
        log "Process $name ($pid) was already stopped."
        return 0
    fi
    #
    # NOTE: Chances are we have already waited for the process in the
    #       SIGCHLD handler (wait-for-pid). Therefore, it's unlikely that
    #       we'll be killing a reused PID next.
    #
    # Tell the SIGCHLD handler (wait-for-procs) to leave this process to us.
    PROCS[$name@stopping]=x
    local rc=0 stopped="stopped."

    # Give the process group STOP_TIMEOUT seconds to exit, then KILL it, so
    # that a process ignoring the signal can't hang the server.
    if kill -s $OPT_SIGNAL -$pid 2>/dev/null; then
        if ! is-pid-gone $pid "$STOP_TIMEOUT"; then
            kill -s KILL -$pid 2>/dev/null
            stopped="didn't stop within ${STOP_TIMEOUT}s; killed it."
            is-pid-gone $pid 5 || rc=1
        fi
    else
        # kill failed; fine if the group is already gone, though.
        is-pid-gone $pid 0 || rc=1
    fi

    if (( ! rc )); then
        # The whole group is gone, so this doesn't block. The process' exit
        # status goes into PROCS; stopping it succeeded.
        wait $pid; PROCS[$name@status]=$?
        log "Process $name ($pid) $stopped"
    else
        log "Failed stopping $name ($pid)."
    fi
    PROCS[$name@stopping]=
    return $rc
}

# Usage: is-pid-gone PGID SECONDS
# Waits up to SECONDS for all processes in the process group PGID to exit.
is-pid-gone () {
    local tries=$(( ${2:?} * 10 ))
    while kill -0 -${1:?} >/dev/null 2>&1; do
        (( tries-- > 0 )) || return 1 # timed out
        sleep 0.1
    done
    return 0 # no pids are part of the process group
}

list-all-status () {
    local report=$(
        list-all \
          |
        while read -r name; do
            [[ $name ]] || continue
            line=("$name") pid=${PIDS[$name]:-} status=${PROCS[$name@status]:-}
            if [[ $pid ]]; then
                line+=("pid=$pid")
            else
                line+=(-)
            fi
            if [[ $status ]]; then
                line+=("Exited ($status)")
            fi
            (IFS=\;; echo "${line[*]}")
        done \
         |
        column -s \; -t
    )
    log "$report"
}

start-all () {
    local OPT_TIMESTAMP=
    if [[ ${1:-} && $1 == -t ]]; then OPT_TIMESTAMP=x; shift; fi
    local name names; (( $# )) && names="$*" || names=$(list-all)
    for name in $names; do start-process "$name"; done
}

stop-all () {
    local OPT_SIGNAL=TERM
    if [[ $1 == -s ]]; then
        # NOTE: This runs inside the server, so report errors back to the
        #       client instead of exiting (which would kill the server).
        [[ ${2:-} ]] || { log "Missing the SIGNAL argument for option: -s"; return 1; }
        OPT_SIGNAL=${2^^}
        [[ $OPT_SIGNAL == @($ALLOWED_SIGNALS) ]] || {
            log "Only $ALLOWED_SIGNALS is allowed as a stop signal."
            return 1
        }
        set -- "${@:3}"
    fi
    local name names
    if (( $# )); then
        names="$*"
    else
        # Only the started and still running ones, as documented; this avoids
        # "was not started" / "was already stopped" noise, e.g., on Ctrl-C.
        for name in $(list-all); do
            [[ ${PIDS[$name]:-} && ! ${PROCS[$name@status]:-} ]] && names+=" $name"
        done
    fi
    for name in $names; do stop-process "$name"; done
}

display-logs () {
    local name log_files=()
    for name in $(list-all); do log_files+=("$LOG_DIR/$name.log"); done
    exec tail -qF "${log_files[@]}" 2>/dev/null
}

# Usage: describe-exit NAME PID STATUS
describe-exit () {
    local sig
    if (( $3 > 128 )) && sig=$(kill -l $(( $3 - 128 )) 2>/dev/null); then
        echo "Process $1 ($2) was killed by SIG${sig#SIG}."
    else
        echo "Process $1 ($2) exited ($3)."
    fi
}

wait-for-procs () {
    trap wait-for-procs CHLD
    # NOTE: needed to avoid a race condition in Bash that shows a warning like:
    # bash: warning: run_pending_traps: bad value in trap_list[20]: 0x1007f056c

    local name pid
    for name in "${!PIDS[@]}"; do
        [[ ! ${PROCS[$name@stopping]:-} ]] || continue  # stop-process waits for it
        pid=${PIDS[$name]}
        if ! kill -0 $pid >/dev/null 2>&1 && [[ ! ${PROCS[$name@status]:-} ]]; then
            wait $pid >/dev/null 2>&1
            PROCS[$name@status]=$?
            describe-exit "$name" $pid ${PROCS[$name@status]} >&2
        fi
    done
}

trap 'SHUTDOWN=x REPLY_LOCAL=x; stop-all; reply; exit' INT

LOG_DIR=$(mktemp -d) || die "Failed creating a temporary logging directory!"
echo "Logging to $LOG_DIR ..."
EXIT_CMDS+=('rm -rf "$LOG_DIR"')

# DEBUG:
#exec {BASH_XTRACEFD}>bpm.trace; set -x

display-logs & tail_pid=$!
# NOTE: Give tail a moment to show the processes' last lines (e.g., what they
#       print when stopped on Ctrl-C) before killing it. tail -F may poll the
#       files only once per second.
EXIT_CMDS+=('sleep 1; kill $tail_pid >/dev/null 2>&1')


action= args=
if (( $# )); then
    action=$1 args=${*:2} REPLY_LOCAL=x
fi

trap wait-for-procs CHLD

until [[ $SHUTDOWN ]]; do
    [[ $action ]] || {
        read -r action args < "$CMD_FIFO"

        [[ $action ]] || { reply; continue; }
    }
    case $action in
        start|stop)
            $action-all $args; reply
            ;;
        list)
            list-all-status; reply 0
            ;;
        *) log "Unknown command: $action $args"; reply 1
            ;;
    esac
    action= args= REPLY_LOCAL=
done
